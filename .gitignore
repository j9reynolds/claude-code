.DS_Store

# mcleod-ops runtime state: event ledger and source cursors, holding
# operational data about real loads, carriers, and customers.
.claude/mcleod-ops/

# Python bytecode from plugin scripts
__pycache__/
*.pyc

# Semgrep Guardian machine-local state (auth tokens, anonymous user id, expiry).
# Written into whichever directory the guardian hook runs from, at any depth.
# Per-machine and ephemeral - never commit.
.semgrep/
